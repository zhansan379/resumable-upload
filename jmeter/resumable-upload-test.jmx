<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="大文件分片上传-断点续传/秒传 测试计划">
      <stringProp name="TestPlan.comments">测试 Spring Boot 大文件上传服务(默认 http://localhost:8080)。前置条件：1) 后端已启动；2) testdata/jmeter 下存在 chunk_0.bin..chunk_19.bin（由 tmp/split-chunks.mjs 生成）。场景：02完整上传(真实MD5) / 03秒传 / 04断点续传+409+幂等 / 05异常边界 / 06并发负载。负载组使用随机伪hash，服务端合并后MD5校验会记录失败日志属预期；重负载压测建议启动后端时加 --app.upload.verify-md5-after-merge=false</stringProp>
      <boolProp name="TestPlan.serialize_threadgroups">true</boolProp>
      <boolProp name="TestPlan.tearDown_on_shutdown">true</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="用户定义的变量">
        <collectionProp name="Arguments.arguments">
          <elementProp name="PROTOCOL" elementType="Argument">
            <stringProp name="Argument.name">PROTOCOL</stringProp>
            <stringProp name="Argument.value">${__P(protocol,http)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="HOST" elementType="Argument">
            <stringProp name="Argument.name">HOST</stringProp>
            <stringProp name="Argument.value">${__P(host,localhost)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="PORT" elementType="Argument">
            <stringProp name="Argument.name">PORT</stringProp>
            <stringProp name="Argument.value">${__P(port,8080)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="CHUNK_DIR" elementType="Argument">
            <stringProp name="Argument.name">CHUNK_DIR</stringProp>
            <stringProp name="Argument.value">${__P(chunkDir,D:/Project/javaProject/resumable-upload/testdata/jmeter)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="FILE_NAME" elementType="Argument">
            <stringProp name="Argument.name">FILE_NAME</stringProp>
            <stringProp name="Argument.value">test-100MB.bin</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="TOTAL_SIZE" elementType="Argument">
            <stringProp name="Argument.name">TOTAL_SIZE</stringProp>
            <stringProp name="Argument.value">104857600</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="TOTAL_CHUNKS" elementType="Argument">
            <stringProp name="Argument.name">TOTAL_CHUNKS</stringProp>
            <stringProp name="Argument.value">20</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="CHUNK_SIZE" elementType="Argument">
            <stringProp name="Argument.name">CHUNK_SIZE</stringProp>
            <stringProp name="Argument.value">5242880</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="REAL_HASH" elementType="Argument">
            <stringProp name="Argument.name">REAL_HASH</stringProp>
            <stringProp name="Argument.value">9c42e41deba91004c2d523db2eeb1208</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
        </collectionProp>
      </elementProp>
    </TestPlan>
    <hashTree>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="02-完整上传(真实MD5全链路)">
        <intProp name="ThreadGroup.num_threads">1</intProp>
